      <span class="status-spacer"></span>
      <span class="status-location">Vorarlberg, AT</span>
      <span>utf-8</span>
      <span data-scroll-progress>0%</span>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </div>

  <script>
    const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-section]')];
    const sections = [...document.querySelectorAll<HTMLElement>('[data-buffer]')];
    const statusFile = document.querySelector<HTMLElement>('[data-status-file]');
    const bufferName = document.querySelector<HTMLElement>('[data-buffer-name]');
    const scrollProgress = document.querySelector<HTMLElement>('[data-scroll-progress]');

    const setActiveSection = (section: HTMLElement) => {
      const id = section.id;
      const filename = section.dataset.buffer ?? 'kamran.ts';
      sectionLinks.forEach((link) => link.classList.toggle('is-active', link.dataset.section === id));
      if (statusFile) statusFile.textContent = filename;
      if (bufferName) bufferName.textContent = filename;
    };

    let ticking = false;
    const updateScrollProgress = () => {
      const available = document.documentElement.scrollHeight - window.innerHeight;
      const progress = available > 0 ? Math.round((window.scrollY / available) * 100) : 0;
      const marker = window.innerHeight * 0.3;
      const activeSection = sections.reduce((active, section) => (
        section.getBoundingClientRect().top <= marker ? section : active
      ), sections[0]);
      if (scrollProgress) scrollProgress.textContent = `${progress}%`;
      if (activeSection) setActiveSection(activeSection);
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateScrollProgress);
        ticking = true;
      }
    }, { passive: true });
    updateScrollProgress();
  </script>
</Layout>
