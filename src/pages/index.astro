  <script>
    const heroFrame = document.querySelector<HTMLElement>('.hero-frame');
    const heroStage = document.querySelector<HTMLElement>('.hero-stage');
    const heroImage = document.querySelector<HTMLImageElement>('.hero-image');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const afterPaint = () => Promise.race([
      new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve()))),
      new Promise<void>((resolve) => window.setTimeout(resolve, 120)),
    ]);

    const showHero = () => {
      if (!heroFrame || !heroStage) return;
      heroFrame.classList.remove('is-loading');
      heroFrame.classList.add('is-ready');
      heroStage.removeAttribute('inert');
      heroStage.removeAttribute('aria-hidden');
    };

    const loadHero = async () => {
      if (!heroImage) return showHero();
      const imageReady = heroImage.complete && heroImage.naturalWidth
        ? heroImage.decode().catch(() => undefined)
        : new Promise<void>((resolve) => {
            heroImage.addEventListener('load', () => resolve(), { once: true });
            heroImage.addEventListener('error', () => resolve(), { once: true });
          });
      const fontReady = Promise.race([
        document.fonts.ready,
        new Promise<void>((resolve) => window.setTimeout(resolve, 1800)),
      ]);
      const mediaReady = Promise.race([
        imageReady,
        new Promise<void>((resolve) => window.setTimeout(resolve, 2500)),
      ]);
      const minimumDelay = new Promise<void>((resolve) => window.setTimeout(resolve, reducedMotion ? 0 : 700));

      await Promise.all([fontReady, mediaReady, minimumDelay]);
      await afterPaint();
      showHero();
    };

    loadHero();

    const animatedElements = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }
    }, { threshold: 0.1 });

    animatedElements.forEach((element) => observer.observe(element));

    const profileBody = document.querySelector<HTMLElement>('.profile-body');
    const letters = [...document.querySelectorAll<HTMLElement>('.animated-char')];
    let ticking = false;
    const updateLetters = () => {
      if (profileBody && letters.length) {
        const rect = profileBody.getBoundingClientRect();
        const start = window.innerHeight * 0.8;
        const end = window.innerHeight * 0.2;
        const progress = Math.max(0, Math.min(1, (start - rect.top) / Math.max(1, start - end + rect.height)));
        letters.forEach((letter, index) => {
          const characterProgress = index / letters.length;
          const opacity = Math.max(0, Math.min(1, (progress - characterProgress + 0.1) / 0.15));
          letter.style.opacity = `${0.2 + opacity * 0.8}`;
        });
      }
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateLetters);
        ticking = true;
      }
    }, { passive: true });
    updateLetters();

    if (reducedMotion) {
      document.querySelectorAll('video').forEach((video) => video.pause());
      letters.forEach((letter) => { letter.style.opacity = '1'; });
    }
  </script>
</Layout>
