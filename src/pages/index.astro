---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImage from '../../content/images/profile.jpg';

const email = 'm4kamran008@gmail.com';
const name = 'Muhammad Kamran';

const files = [
  { id: 'top', file: 'kamran.ts', icon: 'TS', kind: 'ts', short: 'kamran' },
  { id: 'about', file: 'README.md', icon: 'M', kind: 'md', short: 'about' },
  { id: 'work', file: 'experience.ts', icon: 'TS', kind: 'ts', short: 'work' },
  { id: 'health', file: 'health://kamran', icon: '+', kind: 'health', short: 'skills' },
  { id: 'projects', file: 'projects.lua', icon: 'L', kind: 'lua', short: 'projects' },
  { id: 'contact', file: 'contact.sh', icon: '$', kind: 'sh', short: 'contact' },
];

const experiences = [
  {
    company: 'Platomics',
    role: 'Senior Software Engineer, Full Stack',
    period: '2024 – now',
    place: 'Dornbirn, remote',
    notes: [
      'Took a new product from concept to MVP and set most of its architecture: Angular and Nx in front, Spring Boot behind.',
      'Ship production releases on Kubernetes with GitOps (Flux), and write the Java APIs and database migrations when a feature needs them.',
      'Built Python pipelines that use LLMs and RAG to read technical documents and create manufacturer product data without manual entry.',
      'Introduced Playwright end-to-end and visual regression tests; build shared Storybook components with the frontend guild.',
      'Review, pair with and mentor the junior engineers on the team.',
    ],
    stack: ['Angular', 'Nx', 'Playwright', 'Spring Boot', 'Python', 'Kubernetes'],
    current: true,
  },
  {
    company: 'Triply & Jumio',
    role: 'Senior Software Engineer, Frontend',
    period: '2023 – 2024',
    place: 'Vienna, remote',
    notes: [
      'Merged a set of legacy micro-frontends into one Nx monorepo and set up its CI/CD.',
      'Built several Angular apps with TypeScript and Tailwind.',
      'Added Cypress end-to-end tests and ran community-of-practice sessions on frontend standards.',
    ],
    stack: ['Angular', 'Nx', 'Tailwind', 'Cypress'],
  },
  {
    company: 'Fusonic',
    role: 'Software Engineer, Frontend',
    period: '2020 – 2023',
    place: 'Götzis, Austria',
    notes: [
      'Led the Angular frontend of NeoVac’s energy platform: Nx, Redux-style state, Jest coverage above 90%.',
      'Wrote the GitLab pipeline that builds, tests and publishes the shared UI library; built custom amCharts dashboards.',
      'Shipped an Ionic/Capacitor onboarding app to the App Store and Google Play.',
      'Mentored a junior developer and hosted frontend sessions for the whole company.',
    ],
    stack: ['Angular', 'NgRx', 'Jest', 'Ionic', 'Storybook', 'GitLab CI'],
  },
  {
    company: 'OneByte',
    role: 'Software Engineer, Full Stack',
    period: '2019 – 2020',
    place: 'Islamabad, Pakistan',
    notes: [
      'Built an MVP together with the CTO: REST APIs in Node, Express and TypeScript on PostgreSQL, packaged with Docker.',
      'Rewrote slow JSONB queries so search stayed fast as data grew.',
      'Designed the Angular admin panel, including a dynamic form builder.',
    ],
    stack: ['Node.js', 'PostgreSQL', 'Angular', 'Docker'],
  },
  {
    company: 'LibreHealth',
    role: 'Google Summer of Code',
    period: '2018',
    place: 'Remote',
    notes: ['Wrote reusable Polymer web components for the open-source FHIR toolkit used to build healthcare apps.'],
    stack: ['Web Components', 'FHIR', 'Open source'],
  },
  {
    company: 'Freelance',
    role: 'Web Developer',
    period: '2015 – 2019',
    place: 'Remote',
    notes: ['Started in my first year of university. By graduation I had delivered 200+ websites for small businesses.'],
    stack: ['200+ projects'],
    url: 'https://www.fiverr.com/m4kamran',
  },
];

const health = [
  {
    group: 'frontend',
    checks: [
      ['ok', 'Angular, TypeScript, RxJS, NgRx. Where I’m most at home'],
      ['ok', 'Nx monorepos, shared libraries, Storybook design systems'],
      ['ok', 'React and Next.js when the project calls for it'],
    ],
  },
  {
    group: 'quality',
    checks: [
      ['ok', 'Playwright, Cypress, Jest; visual regression in CI'],
      ['ok', 'Code review, pairing, mentoring'],
    ],
  },
  {
    group: 'backend & delivery',
    checks: [
      ['ok', 'Node/Express, Spring Boot, PostgreSQL'],
      ['ok', 'Docker, Kubernetes, GitOps with Flux, GitLab CI'],
