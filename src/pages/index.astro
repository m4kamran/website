---

<Layout
  title="Muhammad Kamran — Senior Software Engineer"
  description="Senior software engineer in Vorarlberg, Austria. Angular and TypeScript at heart, full stack when the work needs it."
>
  <a class="skip-link" href="#main-buffer">Skip to content</a>

  <div class="shell">
    <header class="tabline">
      <a class="workspace" href="#top"><span class="dim">~/</span>kamran.pro</a>
      <nav class="buffers" aria-label="Sections">
        {files.map((f, i) => (
          <a href={`#${f.id}`} data-nav={f.id} class:list={[{ 'is-active': i === 0 }]}>
            <i class:list={['ico', f.kind]}>{f.icon}</i>{f.short}
          </a>
        ))}
      </nav>
      <span class="branch"><i aria-hidden="true">⎇</i> main</span>
    </header>

    <div class="layout">
      <aside class="explorer" aria-label="File explorer">
        <p class="pane-title">EXPLORER</p>
        <p class="tree-root"><span class="chev">▾</span> kamran.pro</p>
        <nav class="tree" aria-label="Primary">
          <span class="tree-cursor" aria-hidden="true"></span>
          {files.map((f, i) => (
            <a href={`#${f.id}`} data-nav={f.id} data-file={f.file} class:list={[{ 'is-active': i === 0 }]}>
              <i class:list={['ico', f.kind]}>{f.icon}</i><span>{f.file}</span>
            </a>
          ))}
        </nav>

        <div class="keys" aria-label="Keyboard shortcuts">
          <p class="pane-title">KEYS</p>
          <dl>
            <div><dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>scroll</dd></div>
            <div><dt><kbd>gg</kbd> <kbd>G</kbd></dt><dd>top / bottom</dd></div>
            <div><dt><kbd>]]</kbd> <kbd>[[</kbd></dt><dd>next / prev file</dd></div>
            <div><dt><kbd>za</kbd></dt><dd>toggle folds</dd></div>
          </dl>
        </div>

        <p class="explorer-foot"><span>47.27° N</span><span>9.61° E</span></p>
      </aside>

      <div class="buffer">
        <div class="winbar">
          <span class="crumbs"><span class="dim">kamran.pro</span><b>›</b><strong data-winbar>kamran.ts</strong></span>
          <span class="diag"><i></i>0 errors</span>
        </div>

        <main id="main-buffer">
          <!-- kamran.ts -->
          <section id="top" class="file hero" data-file="kamran.ts" aria-labelledby="hero-name">
            <div class="l c"><i>// kamran.ts</i></div>
            <div class="l"></div>
            <div class="l"><span class="k">export const</span> <span class="f">kamran</span> <span class="p">= {'{'}</span></div>
            <div class="l i1 name-line">
              <span class="prop">name</span><span class="p">:</span>
              <h1 id="hero-name" aria-label={name}>
                <span class="q" aria-hidden="true">"</span>
                {nameChars.map((ch, i) => <span class="ch" style={`--c:${i}`} aria-hidden="true">{ch === ' ' ? ' ' : ch}</span>)}
                <span class="q" aria-hidden="true">"</span><span class="p comma" aria-hidden="true">,</span>
              </h1>
            </div>
            <div class="l i1"><span class="prop">role</span><span class="p">:</span> <span class="s">"Senior Software Engineer"</span><span class="p">,</span></div>
            <div class="l i1"><span class="prop">based</span><span class="p">:</span> <span class="s">"Vorarlberg, Austria"</span><span class="p">,</span></div>
            <div class="l i1"><span class="prop">now</span><span class="p">:</span> <a class="s link" href="https://platomics.com" target="_blank" rel="noreferrer">"Platomics"</a><span class="p">,</span></div>
            <div class="l i1"><span class="prop">stack</span><span class="p">: [</span><span class="s">"Angular"</span>, <span class="s">"TypeScript"</span>, <span class="s">"Java"</span>, <span class="s">"Python"</span>, <span class="s">"Kubernetes"</span><span class="p">],</span></div>
            <div class="l"><span class="p">{'}'};</span></div>
            <div class="l"></div>
            <div class="l c prose"><i>// I build web products from the first commit to production.</i></div>
            <div class="l c prose"><i>// Mostly frontend, often full stack, lately with some LLM plumbing.</i></div>
            <div class="l c prose"><i>// A decade in, the part I still like most is when it ships.</i></div>
            <div class="l"></div>
            <div class="l actions">
              <a class="cmd primary" href="#work" data-cmd=":e experience.ts"><span>:e</span> experience.ts</a>
              <a class="cmd" href={`mailto:${email}`} data-cmd=":!mail"><span>:!</span>mail {email}</a>
            </div>
            <div class="l"><span class="cursor" aria-hidden="true"></span></div>
          </section>

          <!-- README.md -->
          <section id="about" class="file" data-file="README.md" aria-labelledby="about-h">
            <div class="l"><h2 id="about-h" class="md-h"><span class="hash">#</span> About</h2></div>
            <div class="l"></div>
            <div class="about">
              <div class="about-copy">
                <p class="l prose">
                  I got into this as a teenager, running a blog about Windows and Linux customisation and
                  breaking its theme over and over until HTML and CSS made sense. That turned into
                  freelancing, then into product teams in Islamabad and, since 2020, in Austria.
                </p>
                <div class="l"></div>
                <p class="l prose">
                  These days I’m a frontend specialist who doesn’t stop at the API boundary. I like
                  owning a feature from the migration to the last pixel, writing tests that catch real
                  bugs, and leaving a codebase easier to work in than I found it.
                </p>
                <div class="l"></div>
                <p class="l prose">
                  I still tweak my dotfiles more than I should. That’s more or less why this site
                  looks like Neovim.
                </p>
                <div class="l"></div>
                <div class="l"><h3 class="md-h sub"><span class="hash">##</span> Education</h3></div>
                <div class="l prose"><span class="bullet">-</span> <strong>BS Software Engineering</strong>, COMSATS University Islamabad <span class="dim">(2015 – 2019)</span></div>
                <div class="l prose"><span class="bullet">-</span> Best Freelancer award, ILC COMSATS</div>
                <div class="l prose"><span class="bullet">-</span> Runner-up in web development at Softec and NaSCon</div>
              </div>

              <figure class="portrait">
                <figcaption><span class="ico img">◧</span> kamran.webp <span class="dim">320×320</span></figcaption>
                <div class="portrait-frame">
                  <Image src={profileImage} alt="Portrait of Muhammad Kamran" width={320} height={320} format="webp" loading="lazy" />
                </div>
              </figure>
            </div>
          </section>

          <!-- experience.ts -->
          <section id="work" class="file" data-file="experience.ts" aria-labelledby="work-h">
            <div class="l"><span class="k">export const</span> <h2 id="work-h" class="f inline">experience</h2> <span class="p">= [</span></div>
            <div class="l i1 c"><i>// six roles, newest first. click a fold, or press za to open them all</i></div>
            <div class="folds">
              {experiences.map((x, i) => (
                <details class="fold" open={i === 0}>
                  <summary class="l i1">
                    <span class="fold-mark" aria-hidden="true"></span>
                    <span class="fold-title"><strong>{x.company}</strong><span class="dim"> · {x.role}</span></span>
                    <span class="fold-fill" aria-hidden="true"></span>
                    <span class="fold-period">{x.current && <i class="live" title="current role"></i>}{x.period}</span>
                  </summary>
                  <div class="fold-body">
                    <div class="l i2 meta"><span class="prop">where</span><span class="p">:</span> <span class="s">"{x.place}"</span><span class="p">,</span></div>
                    {x.notes.map((n) => <div class="l i2 note"><span class="bullet">–</span><span>{n}</span></div>)}
                    <div class="l i2 tags">{x.stack.map((t) => <span class="tag">{t}</span>)}{x.url && <a class="tag link" href={x.url} target="_blank" rel="noreferrer">fiverr ↗</a>}</div>
                  </div>
                </details>
              ))}
            </div>
            <div class="l"><span class="p">];</span></div>
          </section>

          <!-- health://kamran -->
          <section id="health" class="file" data-file="health://kamran" aria-labelledby="health-h">
            <div class="l"><span class="dim">:</span><span class="k">checkhealth</span> <span class="f">kamran</span></div>
            <div class="l rule" aria-hidden="true"></div>
            <div class="l"><h2 id="health-h" class="health-h">kamran: <span class="dim">require("kamran.health").check()</span></h2></div>
            {health.map((g) => (
              <>
                <div class="l"></div>
                <div class="l"><h3 class="health-group">{g.group}</h3></div>
                {g.checks.map(([level, text]) => (
                  <div class:list={['l', 'i1', 'check', level]}>
                    <span class="badge">{level === 'ok' ? 'OK' : 'WARNING'}</span> {text}
                  </div>
                ))}
              </>
            ))}
          </section>

          <!-- projects.lua -->
          <section id="projects" class="file" data-file="projects.lua" aria-labelledby="projects-h">
            <div class="l"><span class="k">local</span> <h2 id="projects-h" class="f inline">side_projects</h2> <span class="p">= {'{'}</span></div>
            <div class="l i1 c"><i>-- things built outside the day job</i></div>
            <div class="projects">
              <article class="card l i1">
                <div class="card-art" aria-hidden="true">
                  <svg viewBox="0 0 600 340" fill="none">
                    <path class="draw contour" d="M-20 316C74 179 131 291 201 171C271 51 398 129 442 26C486-77 579 37 639-35"></path>
                    <path class="draw contour" d="M-3 353C89 220 156 322 232 200C308 78 421 158 471 56"></path>
                    <rect class="draw" x="222" y="30" width="156" height="280" rx="18"></rect>
                    <path class="draw land" d="M234 250l38-62 30 32 28-64 44 54v54H234Z"></path>
                    <path class="draw" d="M280 46h40"></path>
                  </svg>
                </div>
                <div class="card-body">
                  <p class="card-kicker">consumer · mobile</p>
                  <h3>Wallpaper app</h3>
                  <p>A wallpaper app on the App Store, written with web tech and shipped as a native app through Capacitor.</p>
                  <p class="tags"><span class="tag">Next.js</span><span class="tag">React</span><span class="tag">Capacitor</span></p>
                </div>
              </article>
              <article class="card l i1">
                <div class="card-art" aria-hidden="true">
                  <svg viewBox="0 0 600 340" fill="none">
                    <path class="draw road" d="M-20 297C83 224 130 301 221 210C312 119 359 187 443 95C488 46 534 28 620 12"></path>
                    <path class="draw road minor" d="M39 -12C114 68 174 11 251 78C328 145 392 267 629 219"></path>
                    <circle class="pulse" cx="221" cy="210" r="30"></circle>
                    <circle class="dot" cx="221" cy="210" r="6"></circle>
                    <rect class="draw" x="376" y="48" width="143" height="74"></rect>
                    <path class="draw signal" d="M390 85h17l9-17 13 36 10-19h66"></path>
                  </svg>
                </div>
                <div class="card-body">
                  <p class="card-kicker">health · realtime</p>
                  <h3>Salama</h3>
                  <p>Hospital staff watch incoming ambulances on a live map and see the patient’s condition before arrival. Angular dashboard, Node API, Flutter apps, FHIR data, Stripe and push notifications.</p>
                  <p class="tags"><span class="tag">Angular</span><span class="tag">Node.js</span><span class="tag">Flutter</span><span class="tag">FHIR</span></p>
                </div>
              </article>
            </div>
            <div class="l"><span class="p">{'}'}</span></div>
          </section>

          <!-- contact.sh -->
          <section id="contact" class="file contact" data-file="contact.sh" aria-labelledby="contact-h">
            <div class="l c"><i>#!/usr/bin/env bash</i></div>
            <div class="l c"><i># A role, a side project, or just shop talk: email works best.</i></div>
            <div class="l"></div>
            <div class="l"><span class="k">email</span>=<span class="s">"{email}"</span></div>
            <div class="l"><span class="f">open</span> <span class="s">"mailto:$email"</span></div>
            <div class="l"></div>
            <div class="l term">
              <p class="term-prompt"><span class="ok">❯</span> ./contact.sh</p>
              <h2 id="contact-h"><a href={`mailto:${email}`}>Say hello<span class="cursor" aria-hidden="true"></span></a></h2>
              <div class="term-actions">
                <a class="cmd primary" href={`mailto:${email}`}><span>↗</span> {email}</a>
                <button class="cmd" type="button" data-yank={email}><span>yy</span> copy address</button>
              </div>
              <p class="elsewhere">
                <a href="https://github.com/m4kamran" target="_blank" rel="noreferrer">github</a>
                <a href="https://linkedin.com/in/m4kamran" target="_blank" rel="noreferrer">linkedin</a>
              </p>
            </div>
          </section>

          <div class="eob" aria-hidden="true">{Array.from({ length: 6 }, () => <span>~</span>)}</div>
        </main>
      </div>
    </div>

    <footer class="statusbar">
      <div class="statusline">
        <span class="mode" data-mode>NORMAL</span>
        <span class="sl-branch"><i aria-hidden="true">⎇</i> main</span>
        <span class="sl-file" data-status-file>kamran.ts</span>
        <span class="sl-spacer"></span>
        <span class="sl-meta">utf-8</span>
        <span class="sl-meta">Vorarlberg, AT</span>
        <span class="sl-pos" data-pos>Top</span>
      </div>
      <div class="cmdline" aria-live="polite"><span data-cmdline></span></div>
    </footer>
  </div>

  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s);
    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
    const sections = [...document.querySelectorAll<HTMLElement>('section.file')];
    const folds = [...document.querySelectorAll<HTMLDetailsElement>('details.fold')];
    const modeEl = $('[data-mode]');
    const cmdline = $('[data-cmdline]');
    const winbar = $('[data-winbar]');
    const statusFile = $('[data-status-file]');
    const pos = $('[data-pos]');
    const tree = $('.tree');
    const treeCursor = $('.tree-cursor');

    // --- mode -------------------------------------------------------------
    let lockedMode: string | null = null;
    const setMode = (mode: string) => {
      if (!modeEl || modeEl.textContent === mode) return;
      modeEl.textContent = mode;
      modeEl.dataset.mode = mode.toLowerCase();
    };

    // --- cmdline ----------------------------------------------------------
    let typingTimer: number | undefined;
    let clearTimer: number | undefined;
    const echo = (text: string, opts: { type?: boolean; then?: string } = {}) => {
      if (!cmdline) return;
      window.clearInterval(typingTimer);
      window.clearTimeout(clearTimer);
      const finish = () => {
        if (opts.then) window.setTimeout(() => (cmdline.textContent = opts.then!), 260);
        clearTimer = window.setTimeout(() => (cmdline.textContent = ''), 4200);
      };
      if (!opts.type || reduced) {
        cmdline.textContent = text;
        return finish();
      }
      let i = 0;
      cmdline.textContent = '';
      typingTimer = window.setInterval(() => {
        cmdline.textContent = text.slice(0, ++i);
        if (i >= text.length) {
          window.clearInterval(typingTimer);
          finish();
        }
      }, 28);
    };

    // --- active file --------------------------------------------------------
    let current = '';
    const lineCount = (s: HTMLElement) => s.querySelectorAll('.l').length;
    const setActive = (section: HTMLElement) => {
      if (section.id === current) return;
      current = section.id;
      const file = section.dataset.file ?? '';
      navLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.nav === section.id));
      if (winbar) winbar.textContent = file;
      if (statusFile) statusFile.textContent = file;
      const active = tree?.querySelector<HTMLElement>('a.is-active');
      if (active && treeCursor) {
        treeCursor.style.transform = `translateY(${active.offsetTop}px)`;
        treeCursor.style.height = `${active.offsetHeight}px`;
      }
      document.querySelector('.buffers a.is-active')?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    let ticking = false;
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const pct = max > 0 ? Math.round((scrollY / max) * 100) : 0;
      if (pos) pos.textContent = scrollY < 8 ? 'Top' : pct >= 99 ? 'Bot' : `${pct}%`;
      const marker = innerHeight * 0.35;
      const active = sections.reduce((acc, s) => (s.getBoundingClientRect().top <= marker ? s : acc), sections[0]);
      if (active) setActive(active);
      ticking = false;
    };
    addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(onScroll); ticking = true; }
    }, { passive: true });
    addEventListener('resize', () => { current = ''; onScroll(); });

    navLinks.forEach((a) => a.addEventListener('click', () => {
      const s = document.getElementById(a.dataset.nav ?? '');
      if (s) echo(`:e ${s.dataset.file}`, { type: true, then: `"${s.dataset.file}" ${lineCount(s)}L` });
    }));
    document.querySelectorAll<HTMLElement>('[data-cmd]').forEach((el) =>
      el.addEventListener('click', () => echo(el.dataset.cmd ?? '', { type: true })),
    );

    // --- reveal ---------------------------------------------------------------
    sections.forEach((s) => s.querySelectorAll<HTMLElement>(':scope .l').forEach((l, i) => l.style.setProperty('--i', String(Math.min(i, 24)))));
    if ('IntersectionObserver' in window && !reduced) {
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -12% 0px' });
      sections.forEach((s) => io.observe(s));
    } else {
      sections.forEach((s) => s.classList.add('is-in'));
    }

    // --- yank -----------------------------------------------------------------
    document.querySelectorAll<HTMLButtonElement>('[data-yank]').forEach((b) => b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.yank ?? '');
        echo(`"${b.dataset.yank}" yanked to clipboard`);
        b.classList.add('is-yanked');
        window.setTimeout(() => b.classList.remove('is-yanked'), 900);
      } catch {
        echo('E353: Nothing in register "+');
      }
    }));

    // --- visual mode on selection -----------------------------------------------
    document.addEventListener('selectionchange', () => {
      if (lockedMode) return;
      const sel = document.getSelection();
      setMode(sel && !sel.isCollapsed && sel.toString().trim() ? 'VISUAL' : 'NORMAL');
    });

    // --- keys -----------------------------------------------------------------
    let pending = '';
    let pendingTimer: number | undefined;
    const go = (dir: 1 | -1) => {
      const i = sections.findIndex((s) => s.id === current);
      const next = sections[Math.max(0, Math.min(sections.length - 1, i + dir))];
      next?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
      if (next) echo(`:e ${next.dataset.file}`);
    };
    addEventListener('keydown', (e) => {
      // Modifier keys fire their own keydown (Shift for G, AltGr for [ ] on German layouts);
      // ignore them so they don't reset a pending g / z / [ / ].
      if (e.key.length !== 1 && e.key !== 'Escape') return;
      // AltGr reports as Ctrl+Alt on Windows, so only bail on real shortcuts.
      const altGr = e.getModifierState?.('AltGraph');
      if (e.metaKey || (!altGr && (e.ctrlKey || e.altKey))) return;
      const t = e.target;
      if (t instanceof Element && t.closest('input, textarea, select, [contenteditable]')) return;
      const key = pending + e.key;
      window.clearTimeout(pendingTimer);
      pending = '';
      const behavior: ScrollBehavior = reduced ? 'auto' : 'smooth';
      switch (key) {
        case 'j': scrollBy({ top: 72, behavior }); break;
        case 'k': scrollBy({ top: -72, behavior }); break;
        case 'gg': scrollTo({ top: 0, behavior }); echo('gg'); break;
        case 'G': scrollTo({ top: document.documentElement.scrollHeight, behavior }); echo('G'); break;
        case ']]': go(1); break;
        case '[[': go(-1); break;
        case 'za': {
          const open = folds.some((f) => !f.open);
          folds.forEach((f) => (f.open = open));
          echo(open ? `${folds.length} folds opened` : `${folds.length} folds closed`);
          break;
        }
        case 'g': case ']': case '[': case 'z':
          pending = key;
          pendingTimer = window.setTimeout(() => (pending = ''), 1000);
          break;
        case ':': echo(':', {}); break;
        case 'Escape': setMode('NORMAL'); echo(''); break;
        default: return;
      }
    });

    // --- boot -----------------------------------------------------------------
    onScroll();
    if (!reduced) {
      lockedMode = 'INSERT';
      setMode('INSERT');
      window.setTimeout(() => { lockedMode = null; setMode('NORMAL'); }, 1500);
      window.setTimeout(() => echo(':e kamran.ts', { type: true, then: `"kamran.ts" ${lineCount(sections[0])}L  ·  press j / k to move, ]] for next file` }), 300);
    }
  </script>
</Layout>
